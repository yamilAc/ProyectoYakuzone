PORT=3001
MQTT_PORT=1883
# Secreto del que se derivan las contraseñas MQTT de cada nodo (texto largo
# al azar). Vacío = el broker no pide contraseña. La de un nodo se obtiene
# con: npm run clave-nodo -- SN-010
MQTT_SECRETO=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=yakuDB

JWT_SECRET=

# Módulo de mitigación (API de Gemini + correo SMTP)
GEMINI_API_KEY=
# Modelos que se prueban en orden si el anterior falla (opcional; esta es la
# lista por defecto).
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yakuzone <no-reply@yakuzone.com>

# Avisos por WhatsApp al jefe del equipo (WhatsApp Cloud API de Meta, ver README)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=alerta_asignada
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v23.0

# Servicio de aprendizaje automático (carpeta ml/ del proyecto). "desactivado"
# apaga los ciclos de análisis y pronóstico.
ML_URL=http://127.0.0.1:8000
