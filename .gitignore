# Solo se versionan el backend (node/), el frontend (yakuzone/) y el
# servicio de aprendizaje automático (ml/)
/*
!/.gitignore
!/node/
!/yakuzone/
!/ml/

# Repositorio inicial de Create React App (sin contenido del proyecto)
/yakuzone/.git_cra_inicial/

# Dependencias, compilados, secretos y temporales
node_modules/
build/
.env
# Fotos de evidencia subidas por los equipos de mitigación (datos, no código)
/node/uploads/
# Aprendizaje automático: entorno de Python y datasets descargados (se
# documenta en ml/README.md de dónde obtenerlos)
/ml/.venv/
/ml/datos/
__pycache__/
.ipynb_checkpoints/
*.log
~$*
